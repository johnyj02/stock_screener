ify/references/query.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Literal matching lacks stemming, synonyms, and translation, so expansion selects only tokens actually present in node labels."},{"id":"_codex_skills_graphify_references_query_work_memory","label":"Graph query work memory","file_type":"rationale","source_file":"/mnt/d/projects/stock_screener/.codex/skills/graphify/references/query.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Saved answers and useful, dead-end, or corrected outcomes feed reflection lessons that identify preferred sources and avoid repeated mistakes."},{"id":"_codex_skills_graphify_references_update_replace_on_reextract","label":"Replace-on-re-extract graph merge","file_type":"rationale","source_file":"/mnt/d/projects/stock_screener/.codex/skills/graphify/references/update.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Changed sources replace prior content; only deleted files enter pruning. Consistent roots and preserved edge direction prevent stale nodes and lost relationships."},{"id":"_codex_skills_graphify_references_update_semantic_manifest","label":"Successful-extraction semantic manifest","file_type":"rationale","source_file":"/mnt/d/projects/stock_screener/.codex/skills/graphify/references/update.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Only semantic files that produced output are stamped; failed or omitted extractions remain eligible for the next update."},{"id":"agents_stock_screener_core","label":"Stock screener core and strategies","file_type":"concept","source_file":"/mnt/d/projects/stock_screener/AGENTS.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null},{"id":"agents_strategy_backtester","label":"Strategy backtest engine