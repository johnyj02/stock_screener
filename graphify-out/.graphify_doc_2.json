ce_file":"/mnt/d/projects/stock_screener/docs/trading_variables.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Fixed and proportional commissions plus adverse directional slippage reduce net returns and can eliminate marginal trade profitability."},{"id":"docs_trading_variables_turnover_metrics","label":"Turnover metrics","file_type":"concept","source_file":"/mnt/d/projects/stock_screener/docs/trading_variables.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Gross turnover uses full traded notional, margin-adjusted turnover scales futures notional by margin, and annualized variants normalize by trading days."},{"id":"docs_trading_variables_regime_gates","label":"Regime gates","file_type":"rationale","source_file":"/mnt/d/projects/stock_screener/docs/trading_variables.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Trend state, volatility state, and risk-on probability control strategy entry eligibility; optional regime buckets scale risk and hysteresis reduces threshold oscillation."},{"id":"docs_trading_variables_profit_protection","label":"Profit protection","file_type":"rationale","source_file":"/mnt/d/projects/stock_screener/docs/trading_variables.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Breakeven, trailing stops, partial exits, giveback exits, and decay exits trade off profit retention, upside participation, and capital tied up in stalled trades."},{"id":"grid_search_grid_search_guidelines","label":"Grid search guidelines","file_type":"document","source_file":"/mnt/d/projects/stock_screener/grid_search.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null},{"id":"grid_search_fixed_parameters","label":"Fixed parameters","file_type":"rationale","source_file":"/mnt/d/projects/stock_screener/grid_search.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Keep universe, time windows, data plumbing, market dependencies, output settings, and costs fixed by default; costs vary only for explicit stress tests."},{"id":"grid_search_regime_tuning","label":"Regime tuning","file_type":"rationale","source_file":"/mnt/d/projects/stock_screener/grid_search.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Use small ranges for risk-on thresholds, hysteresis, hedge limits, risk buckets, and exposure caps; keep regime symbols, intraday alignment, and missing-data policies fixed."},{"id":"requirements_runtime_dependencies","label":"Runtime dependencies","file_type":"document","source_file":"/mnt/d/projects/stock_screener/requirements.txt","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null},{"id":"requirements_dev_pytest","label":"pytest","file_type":"concept","source_file":"/mnt/d/projects/stock_screener/requirements-dev.txt","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null},{"id":"src_strategy_backtester_config_ablation_config_ablation_configuration","label":"Ablation configuration","file_type":"document","source_file":"/mnt/d/projects/stock_screener/src/strategy_backtester/config/ablation_config.yaml","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Compares the default strategy suite using leave-one-out, add-one-in, strategy groups, time splits, and engine or strategy parameter grids."},{"id":"src_strategy_backtester_config_ablation_doublebottom_double_bottom_exit_ablation","label":"Double bottom exit ablation","file_type":"document","source_file":"/mnt/d/projects/stock_screener/src/strategy_backtester/config/ablation_doublebottom.yaml","source_location":null,"source_url":null,"captured_at"