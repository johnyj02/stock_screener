on.yaml","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"A reduced comparison baseline enables PullbackToEma, BullishEngulfing, VptBreakout, GoldenCross, and MacdTurnaround."},{"id":"src_strategy_backtester_config_backtest_experiment_combo_combined_deployment_cost_experiment","label":"Combined deployment cost experiment","file_type":"document","source_file":"/mnt/d/projects/stock_screener/src/strategy_backtester/config/backtest_experiment_combo.yaml","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null},{"id":"src_strategy_backtester_config_backtest_experiment_costs_execution_cost_experiment","label":"Execution cost experiment","file_type":"document","source_file":"/mnt/d/projects/stock_screener/src/strategy_backtester/config/backtest_experiment_costs.yaml","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Adds fixed and proportional commissions and two basis points of slippage to evaluate execution cost sensitivity."},{"id":"src_strategy_backtester_config_backtest_experiment_deploy_deployment_sizing_experiment","label":"Deployment sizing experiment","file_type":"document","source_file":"/mnt/d/projects/stock_screener/src/strategy_backtester/config/backtest_experiment_deploy.yaml","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Raises trade_size to 6000 and max_alloc_pct to 0.9 to evaluate higher capital deployment."},{"id":"src_strategy_backtester_config_backtest_experiment_shorts_risk_on_short_experiment","label":"Risk-on short experiment","file_type":"document","source_file":"/mnt/d/projects/stock_screener/src/strategy_backtester/config/backtest_experiment_shorts.yaml","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Enables allow_short_risk_on to evaluate short entries during risk-on regimes."},{"i